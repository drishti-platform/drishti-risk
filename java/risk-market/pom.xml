<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.risk</groupId>
    <artifactId>risk-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>risk-market</artifactId>
  <name>Drishti Risk: risk-market</name>
  <description>Market risk: historical VaR and ES (rank rules, component, incremental, marginal), parametric VaR, backtesting, stressed windows, 10-day, currencies and scenario FX, intraday overlay, what-if on supplied vectors, system baskets, period statistics, regulatory reports, sensitivities and the MR cube, FRTB-SA as it stands. Moved with history from Drishti (K3). Depends on risk-api and risk-kernel only, never on another line of business (LineOfBusinessIsolationTest).</description>
  <properties>
    <automatic.module.name>com.ash.risk.market</automatic.module.name>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.risk</groupId><artifactId>risk-api</artifactId></dependency>
    <dependency><groupId>com.ash.risk</groupId><artifactId>risk-kernel</artifactId></dependency>
    <!-- the tests' JSON and YAML reading (the parameter readers read YAML with the platform's StrictYaml) -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-tck</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
