<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ash.risk</groupId>
  <artifactId>risk-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Drishti Risk (reactor)</name>

  <modules>
    <module>risk-bom</module>
    <module>risk-api</module>
    <module>risk-kernel</module>
    <!-- each line of business isolated: its own module, its own engine module and JAR, its own product id; never another line's -->
    <module>risk-market</module>
    <module>risk-engine-market</module>
    <module>risk-ccr</module>
    <module>risk-engine-ccr</module>
    <module>risk-liquidity</module>
    <module>risk-engine-liquidity</module>
    <module>risk-climate</module>
    <module>risk-engine-climate</module>
    <module>risk-guards</module>
  </modules>

  <properties>
    <risk.reference.dir></risk.reference.dir>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-11-22T00:00:00Z</project.build.outputTimestamp>
    <!-- the engine contract and the family libraries: released tags installed in the local repository (the engine's 0.1 while it is cut) -->
    <drishti.engine.version>0.1.0-SNAPSHOT</drishti.engine.version>
    <drishti.tools.version>1.1.0</drishti.tools.version>
    <argLine></argLine>
    <!-- the engine API level the engine JARs are built against (their manifest's Engine-Api) -->
    <engine.api.built>0.1</engine.api.built>
    <!-- the private libraries merged into the engine JARs, at the versions Drishti used at the freeze commit (bit-exact) -->
    <arrow.version>19.0.0</arrow.version>
    <javacpp.version>1.5.10</javacpp.version>
    <openblas.version>0.3.26-${javacpp.version}</openblas.version>
    <slf4j.version>2.0.16</slf4j.version>
    <!-- K3 exemption (java/SPLIT_EXEMPTIONS.md): the moved code still reads YAML and JSON with Jackson; K4/K5 replace it -->
    <jackson.version>2.18.2</jackson.version>
    <drishti.lake.version>0.9.1</drishti.lake.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.ash.engine</groupId><artifactId>engine-bom</artifactId><version>${drishti.engine.version}</version><type>pom</type><scope>import</scope></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-bom</artifactId><version>${drishti.tools.version}</version><type>pom</type><scope>import</scope></dependency>
      <dependency><groupId>com.ash.risk</groupId><artifactId>risk-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.risk</groupId><artifactId>risk-kernel</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.risk</groupId><artifactId>risk-market</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.risk</groupId><artifactId>risk-ccr</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.risk</groupId><artifactId>risk-liquidity</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.ash.risk</groupId><artifactId>risk-climate</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.apache.arrow</groupId><artifactId>arrow-vector</artifactId><version>${arrow.version}</version></dependency>
      <dependency><groupId>org.apache.arrow</groupId><artifactId>arrow-memory-unsafe</artifactId><version>${arrow.version}</version></dependency>
      <dependency><groupId>org.bytedeco</groupId><artifactId>javacpp</artifactId><version>${javacpp.version}</version></dependency>
      <dependency><groupId>org.bytedeco</groupId><artifactId>javacpp</artifactId><version>${javacpp.version}</version><classifier>linux-x86_64</classifier></dependency>
      <dependency><groupId>org.bytedeco</groupId><artifactId>javacpp</artifactId><version>${javacpp.version}</version><classifier>windows-x86_64</classifier></dependency>
      <dependency><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId><version>${openblas.version}</version></dependency>
      <dependency><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId><version>${openblas.version}</version><classifier>linux-x86_64</classifier></dependency>
      <dependency><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId><version>${openblas.version}</version><classifier>windows-x86_64</classifier></dependency>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${slf4j.version}</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>com.ash.lake</groupId><artifactId>lake-tck</artifactId><version>${drishti.lake.version}</version></dependency>
      <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.12.2</version></dependency>
      <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>3.27.7</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
        <plugin><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version></plugin>
        <plugin><artifactId>maven-failsafe-plugin</artifactId><version>3.5.2</version></plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><compilerArgs><arg>-Xlint:all,-serial,-processing,-try</arg></compilerArgs></configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><archive><manifestEntries><Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name></manifestEntries></archive></configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <tempDir>tmp</tempDir>
          <argLine>@{argLine} -Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
          <systemPropertyVariables>
            <risk.repo.root>${maven.multiModuleProjectDirectory}/..</risk.repo.root>
            <!-- a Drishti checkout holding the reference data the moved equivalence tests read (data/testdata/market-risk and
                 counterparty-risk, the packs' capital files, docs/architecture/capital-parameters): -Drisk.reference.dir=/abs/drishti;
                 without it those tests are skipped, saying so -->
            <risk.reference.dir>${risk.reference.dir}</risk.reference.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <bannedDependencies>
                  <!-- names no host (9.1): no Drishti artifact, no framework, no Jackson, in any scope -->
                  <excludes>
                    <exclude>com.ash.drishti*:*</exclude>
                    <exclude>org.springframework*:*</exclude>
                    <!-- com.fasterxml.jackson*: banned again when K4/K5 remove the moved code's last use (java/SPLIT_EXEMPTIONS.md) -->
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
