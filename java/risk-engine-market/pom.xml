<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.risk</groupId>
    <artifactId>risk-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>risk-engine-market</artifactId>
  <name>Drishti Risk: risk-engine-market (the market-risk engine; its JAR drishti-risk-market-&lt;version&gt;.jar)</name>
  <description>The market-risk engine against engine-api (product id drishti-risk-market, separately licensable): a descriptor and a thin Engine over risk-market. The package phase writes the one engine JAR a host copies into lib/engines: this module, risk-api, risk-kernel and risk-market, with the private libraries merged in; the platform packages (engine-api, drishti-tools, Lake, Rachana) are the host's and never inside.</description>
  <properties>
    <automatic.module.name>com.ash.risk.market.engine</automatic.module.name>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.risk</groupId><artifactId>risk-market</artifactId></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-files</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-tck</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-inputs-files</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive><manifestEntries><Engine-Api>${engine.api.built}</Engine-Api></manifestEntries></archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>drishti-risk-market-${project.version}</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <!-- platform packages: the host's, parent-first (ENGINE_SPEC 17.1, 17.3) -->
                  <exclude>com.ash.engine:*</exclude>
                  <exclude>com.ash.tools:*</exclude>
                  <exclude>com.ash.lake:*</exclude>
                  <exclude>com.ash.rachana:*</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude></excludes></filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- the kit on the merged JAR, as a host will meet it: after package -->
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
        <configuration>
          <tempDir>tmp</tempDir>
          <argLine>-Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
          <systemPropertyVariables>
            <engine.jar>${project.build.directory}/drishti-risk-market-${project.version}.jar</engine.jar>
            <engine.cases>${maven.multiModuleProjectDirectory}/../tck/cases</engine.cases>
            <engine.kit.out>${project.build.directory}/kit</engine.kit.out>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
