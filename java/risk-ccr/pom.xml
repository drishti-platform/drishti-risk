<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.risk</groupId>
    <artifactId>risk-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>risk-ccr</artifactId>
  <name>Drishti Risk: risk-ccr</name>
  <description>Counterparty credit risk: exposure from supplied simulator paths (EE, EPE, EEPE, PFE), netting and collateral as built, pre-deal check, what-if paths, the official exposure, SIMM, the SA-CCR and FVA playgrounds as they stand. Moved with history from Drishti (K3). Depends on risk-api and risk-kernel only, never on another line of business (LineOfBusinessIsolationTest).</description>
  <properties>
    <automatic.module.name>com.ash.risk.ccr</automatic.module.name>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.risk</groupId><artifactId>risk-api</artifactId></dependency>
    <dependency><groupId>com.ash.risk</groupId><artifactId>risk-kernel</artifactId></dependency>
    <!-- K3 exemption (java/SPLIT_EXEMPTIONS.md): the moved parameter readers still read YAML with Jackson; declared here so a test-scoped
         copy through lake-tck never shadows it -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-tck</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
